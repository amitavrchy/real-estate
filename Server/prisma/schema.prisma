generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  AGENT
  ADMIN
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
  RENTED
  OFF_MARKET
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  APT
  CONDO
  TOWNHOUSE
  LAND
  COMMERCIAL
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role          @default(BUYER)
  avatarUrl       String?
  bio             String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  listings        Property[]    @relation("AgentListings")
  favorites       Favorite[]
  collections     Collection[]
  inquiries       Inquiry[]
  savedSearches   SavedSearch[]
  reviewsWritten  Review[]      @relation("ReviewAuthor")
  reviewsReceived Review[]      @relation("ReviewAgent")
}

model Neighborhood {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  city        String
  state       String?
  country     String        @default("US")
  description String?
  heroImage   String?
  lat         Float?
  lng         Float?
  statsJson   Json?
  properties  Property[]
  posts       JournalPost[]
}

model Property {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  description        String
  status             ListingStatus    @default(DRAFT)
  listingType        ListingType
  propertyType       PropertyType
  price              Decimal          @db.Decimal(14, 2)
  currency           String           @default("USD")
  beds               Int?
  baths              Float?
  sqft               Int?
  lotSqft            Int?
  yearBuilt          Int?
  addressLine1       String
  addressLine2       String?
  city               String
  state              String?
  postalCode         String?
  country            String           @default("US")
  lat                Float
  lng                Float
  amenities          String[]
  features           String[]
  isPrivateExclusive Boolean          @default(false)
  publishedAt        DateTime?
  neighborhoodId     String?
  neighborhood       Neighborhood?    @relation(fields: [neighborhoodId], references: [id])
  agentId            String
  agent              User             @relation("AgentListings", fields: [agentId], references: [id])
  media              Media[]
  favorites          Favorite[]
  collectionItems    CollectionItem[]
  inquiries          Inquiry[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([city, listingType, status])
  @@index([price])
  @@index([lat, lng])
}

model Media {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  kind       String   @default("image") // image | floorplan | video
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Collection {
  id        String           @id @default(cuid())
  name      String
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CollectionItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  propertyId   String
  note         String?
  rank         Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([collectionId, propertyId])
}

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String
  userId     String?
  name       String
  email      String
  phone      String?
  message    String
  status     InquiryStatus @default(NEW)
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id])
  createdAt  DateTime      @default(now())
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model JournalPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String
  body           String
  coverImage     String?
  publishedAt    DateTime?
  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  createdAt      DateTime      @default(now())
}

model SellerLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  address   String
  sqft      Int
  low       Int
  high      Int
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  agentId   String
  rating    Int
  body      String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  agent     User     @relation("ReviewAgent", fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([authorId, agentId])
}

// Shared between API replicas; keys contain an HMAC, never a raw client IP.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
