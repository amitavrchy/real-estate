# Haven API + bundled Postgres (single free-tier Render web service).
# Data is ephemeral without a paid disk; migrate + demo seed on every boot.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    openssl \
    postgresql \
    postgresql-contrib \
    procps \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app/Server

# Prisma config requires DATABASE_URL even at generate/build time
ENV DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/haven

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./

# npm install (not ci): lockfile from newer npm can trip npm 10 ci on optional peers
RUN npm install --no-audit --no-fund

COPY src ./src
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Build Nest; keep prisma + tsx for migrate/seed at boot
RUN npx prisma generate \
  && npm run build \
  && npm install prisma@6.19.3 tsx@4.23.15 --no-save --no-audit --no-fund \
  && chmod +x /usr/local/bin/docker-entrypoint.sh \
  && mkdir -p /var/lib/postgresql/data /var/run/postgresql \
  && chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4000 \
    ALLOW_DEMO_SEED=1 \
    PGDATA=/var/lib/postgresql/data \
    POSTGRES_USER=postgres \
    POSTGRES_PASSWORD=postgres \
    POSTGRES_DB=haven \
    DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/haven

EXPOSE 4000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]