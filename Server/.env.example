# Server (NestJS) — copy to .env and fill secrets
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4100
CLIENT_ORIGIN=http://localhost:3001
# Only set this behind an explicitly trusted reverse proxy, using its IP/CIDR.
# TRUST_PROXY=127.0.0.1
